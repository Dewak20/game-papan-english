# ── Database (Supabase / Postgres) ─────────────────────────────────────────────
# Ambil dari Supabase Dashboard → Project Settings → Database → Connection string.
#
# DATABASE_URL = koneksi "Connection pooling" (port 6543) untuk runtime aplikasi.
# DIRECT_URL   = koneksi "Direct connection"  (port 5432) untuk migrasi Prisma.
#
# Jangan pernah commit file .env yang berisi nilai asli.

DATABASE_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Aplikasi ───────────────────────────────────────────────────────────────────
# PIN Panel Guru (default 1234 bila kosong).
TEACHER_PIN="1234"
# Kunci untuk menandatangani cookie sesi guru (isi string acak panjang).
AUTH_SECRET="ganti-dengan-string-acak-panjang"
